{
  "name": "orlan-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @orlan/server",
    "dev:web": "npm run dev -w @orlan/web",
    "build": "npm run build -w @orlan/web && npm run build -w @orlan/server",
    "start": "npm run start -w @orlan/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/game && tsc -p packages/protocol && tsc -p apps/server && tsc -p apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
